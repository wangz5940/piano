          <slur type="stop" number="2" default-x="2" default-y="-60" bezier-x="-96" bezier-y="-28"></slur>
        </notations>
      </note>
      <barline location="right">
        <bar-style>light-heavy</bar-style>
      </barline>
    </measure>
  </part>
</score-partwise>