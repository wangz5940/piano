        <stem default-y="-13">up</stem>
        <staff>2</staff>
      </note>
      <barline location="right">
        <bar-style>light-heavy</bar-style>
        <ending number="2" type="stop" end-length="20" default-y="30"></ending>
      </barline>
    </measure>
  </part>
</score-partwise>