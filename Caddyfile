{
	auto_https disable_redirects
	default_sni {$PANIO_PUBLIC_HOST}
	servers {
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 20s
			write 60s
			idle 30s
		}
	}
}

https://{$PANIO_PUBLIC_HOST} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
			disable_http_challenge
		}
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy piano:4173 {
		transport http {
			response_header_timeout 15s
		}
	}
}

http://:4173 {
	redir https://{$PANIO_PUBLIC_HOST}{uri} 308
}
