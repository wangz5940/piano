{
  "name": "panio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "create:cert": "bash ./scripts/create-dev-cert.sh",
    "start:host": "bash ./scripts/start-host.sh",
    "start:secure-host": "PANIO_DEV_HTTPS=1 bash ./scripts/start-host.sh",
    "stop:host": "bash ./scripts/stop-host.sh",
    "check:host": "bash ./scripts/check-host.sh",
    "serve": "node server/index.mjs",
    "serve:api": "PANIO_API_ONLY=1 node server/index.mjs",
    "admin:create": "node server/admin.mjs",
    "backup": "node server/backup.mjs",
    "capture:jianpu": "node scripts/capture-jianpu.mjs",
    "calibrate:beyer": "vite-node scripts/calibrate-beyer.ts",
    "calibrate:beyer:write": "vite-node scripts/calibrate-beyer.ts --write",
    "sync:jianpu-imported": "node scripts/sync-imported-jianpu.mjs",
    "sync:jianpu-structured": "node scripts/sync-imported-structured-jianpu.mjs",
    "import:hymns:pptx": "node scripts/hymn-pptx/import.mjs",
    "verify:hymns:pptx": "node --test scripts/hymn-pptx/*.node-test.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "test": "vitest run && node --test server/*.node-test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "opensheetmusicdisplay": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-xml-parser": "^5.10.1",
    "globals": "^16.0.0",
    "jszip": "^3.10.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
